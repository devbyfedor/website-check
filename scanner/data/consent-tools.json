  "tools": [
    {
      "id": "usercentrics",
      "name": "Usercentrics",
      "kind": "saas",
      "selectors": [
        "#usercentrics-cmp-ui",
        "#usercentrics-root"
      ],
      "shadowRoot": true,
      "serviceIds": [
        "usercentrics"
      ],
      "evidence": [
        "https://usercentrics.com/docs/web/features/custom-css/configuration/",
        "https://usercentrics.com/docs/web/features/v2/browser_ui/browser_ui/"
      ],
      "note": "Web CMP v3 renders into #usercentrics-cmp-ui, Browser UI v2 into #usercentrics-root, both in an open shadow root. With 'Bot Detection' on, user agents containing HeadlessChrome or Playwright get an automatic accept-all."
    },
    {
      "id": "cookiebot",
      "name": "Cookiebot",
      "kind": "saas",
      "selectors": [
        "#CybotCookiebotDialog"
      ],
      "shadowRoot": false,
      "serviceIds": [
        "cookiebot"
      ],
      "evidence": [
        "https://raw.githubusercontent.com/duckduckgo/autoconsent/main/lib/cmps/cookiebot.ts",
        "https://www.cookiebot.com/en/developer/"
      ],
      "note": "Crawlers are treated as fully consented (support article 360005114894); HeadlessChrome is not in its crawler list. Cookiebot.consent.method is 'implied' for automatic consent."
    },
