{
  "name": "website-check",
  "private": true,
  "type": "module",
  "description": "Website-Check DE: free website checker for German businesses",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "scanner",
    "worker"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config scanner/vitest.integration.config.ts && vitest run --config worker/vitest.integration.config.ts",
    "typecheck": "tsc -p scanner && tsc -p worker",
    "scan:local": "node scanner/src/local/run-sites.ts",
    "explain": "node scanner/src/local/explain.ts",
    "lab:cloudflare": "node scanner/src/local/cloudflare-lab.ts",
    "lab:dev": "wrangler dev -c worker/wrangler.lab.jsonc --ip 127.0.0.1 --port 8787 --var LAB_ALLOW_LOCAL:1 --var LAB_TRACE_URL:http://127.0.0.1:8790/cdn-cgi/trace --var LAB_DEV_ORIGINS:http://127.0.0.1:8790",
    "fixtures:snapshots": "node scanner/src/local/make-fixture-snapshots.ts",
    "report:check": "node scanner/src/local/report-check.ts",
    "lab:e2e": "node scanner/src/local/e2e-lab.ts",
    "lab:e2e:dev": "node scanner/src/local/lab-e2e-dev.ts",
    "lab:cpu": "node scanner/src/local/cpu-lab.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
