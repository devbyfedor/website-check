{
  "name": "@website-check/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The site: Next.js with static export, Tailwind CSS v4, served as static assets. Built from stage B on.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/next.ts dev",
    "build": "node scripts/next.ts build",
    "build:examples": "node scripts/next.ts build --examples",
    "typecheck": "node scripts/next.ts typegen && tsc -p ."
  },
  "dependencies": {
    "@website-check/scanner": "0.1.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.5"
  }
}
