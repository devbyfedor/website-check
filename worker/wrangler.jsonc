// The Worker of Website-Check DE (session A5 part 2): the API, and from part 3 the Durable Object with the
// scan queue and the browser. Not deployed: no deploy before stage C (brief). Local only:
//   npx wrangler d1 migrations apply website-check --local -c worker/wrangler.jsonc
//   npx wrangler dev -c worker/wrangler.jsonc
// Fedor creates the real D1 database before the first deploy and puts its id below; until then the id is
// a placeholder that only works locally.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "website-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Workers Logs would keep request metadata such as the visitor's address; the brief stores no raw IP addresses.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Hourly: delete the salts of earlier days and rate-limit events older than an hour, also without traffic.
  // Free plan; it runs only once the Worker is deployed.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-check",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
