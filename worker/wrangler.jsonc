// The API Worker of Website-Check DE (sessions A5 part 2 to 4): the API, D1 and the hourly cleanup. Since
// A5 part 4 the scan queue with the browser is a Worker of its own (`wrangler.scanner.jsonc`); this Worker
// reaches its Durable Object through the binding below with `script_name`, and bundles no Puppeteer, no
// axe-core and no rules data (reason in docs/decisions.md, A5 part 4).
// Not deployed: no deploy before stage C (brief). Local only, both Workers in one wrangler process:
//   npx wrangler d1 migrations apply website-check --local -c worker/wrangler.jsonc
//   npx wrangler dev -c worker/wrangler.jsonc -c worker/wrangler.scanner.jsonc
// Deploy order in stage C: the scan Worker first (it defines the Durable Object class), then this one.
// Fedor creates the real D1 database before the first deploy and puts its id below and into
// `wrangler.scanner.jsonc`; until then the id is a placeholder that only works locally.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "website-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  // No `nodejs_compat`: the API uses no Node built-ins (the scan Worker needs them for Puppeteer).
  "workers_dev": true,
  "preview_urls": false,
  // Workers Logs would keep request metadata such as the visitor's address; the brief stores no raw IP addresses.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Session B2 part 2: the site itself (the static export of `web/`, `npm run build:web`) is served by Workers Static
  // Assets from this Worker, so pages and API share one host; only `/api/*` runs the Worker (static requests are free
  // and do not count as Worker requests). The scan screen `/pruefung?id=…` is the file `pruefung.html`.
  "assets": {
    "directory": "../web/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Hourly: delete the salts of earlier days and rate-limit events older than an hour, also without traffic,
  // and end scans stuck for half an hour. Free plan; it runs only once the Worker is deployed.
  "triggers": { "crons": ["0 * * * *"] },
  // The scan queue: the Durable Object of the scan Worker, in the EU jurisdiction (chosen in the code).
  "durable_objects": {
    "bindings": [{ "name": "SCAN_QUEUE", "class_name": "ScanQueueObject", "script_name": "website-check-scanner" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-check",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
