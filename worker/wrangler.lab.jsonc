// Lab Worker of sessions A2 and A3 (Fedor's decision of 21.11.2026, docs/decisions.md):
// only the measurement endpoint behind a token, on workers.dev, no site, no storage.
// Deleted after part 3 of A2 and again at the end of A3: npx wrangler delete -c worker/wrangler.lab.jsonc
// Part 2: the capture runs in the Durable Object LabBrowser (EU jurisdiction, chosen in the code);
// the Worker only checks the token. Free plan: SQLite-backed Durable Objects only.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "website-check-lab",
  "main": "src/lab/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // New Workers persist logs by default; the lab stores nothing.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // A3: the pinned axe-core is bundled as a string (the glob matches the import specifier) and injected into the page (worker/src/capture/axe-source.ts).
  "rules": [{ "type": "Text", "globs": ["axe-core/axe.min.js"], "fallthrough": false }],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "LAB_BROWSER", "class_name": "LabBrowser" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LabBrowser"] }]
}
