// Lab pages Worker of session C1 (Fedor's permission in the session message): invented pages at "/" for the
// measurements on Cloudflare (`worker/src/lab/pages.ts`), on workers.dev only. Deleted at the end of the session:
//   npx wrangler delete -c worker/wrangler.lab-pages.local.jsonc
// The database id below is a placeholder (see `wrangler.lab-e2e.jsonc`); the deploy uses a git-ignored copy
// `*.local.jsonc` with the id of the lab database. The secret LAB_TOKEN is set from `worker/.dev.vars` and never printed.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "website-check-lab-pages",
  "main": "src/lab/pages.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-check-lab-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
