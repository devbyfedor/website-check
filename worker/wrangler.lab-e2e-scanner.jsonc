// Lab scan Worker of session A5 part 4 (Fedor's permission, docs/decisions.md): the production entry
// `src/scan-worker.ts` (only the queue object with the browser), reached by the lab API Worker
// (`wrangler.lab-e2e.jsonc`) with `script_name`. No public address. Deploy it before the lab API Worker;
// deleted at the end of the session: npx wrangler delete -c worker/wrangler.lab-e2e-scanner.local.jsonc
// The database id below is a placeholder (see `wrangler.lab-e2e.jsonc`). Since A5 part 5 the start of a scan runs in
// the queue object: the secret RATE_LIMIT_SECRET is set on this Worker from `worker/.dev.vars` and never printed.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "website-check-lab-scanner",
  "main": "src/scan-worker.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "rules": [{ "type": "Text", "globs": ["axe-core/axe.min.js"], "fallthrough": false }],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "SCAN_QUEUE", "class_name": "ScanQueueObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanQueueObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-check-lab-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // One scan at a time, so the browser seconds of the one full check can be read from one session.
  "vars": { "QUEUE_MAX_PARALLEL": "1" }
}
