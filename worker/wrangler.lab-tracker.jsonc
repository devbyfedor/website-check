// Lab tracker Worker of session C1 (Fedor's permission in the session message): the same code as the lab pages
// Worker (`worker/src/lab/pages.ts`), by default the invented page that calls a tracker after 2 s (another with
// `POST /lab/mode`), on a host of its own so that it can be scanned beside the flood of the pages Worker. On workers.dev only. Deleted at the end of the session:
//   npx wrangler delete -c worker/wrangler.lab-tracker.local.jsonc
// The database id below is a placeholder (see `wrangler.lab-e2e.jsonc`). The secret LAB_TOKEN is set from
// `worker/.dev.vars` and never printed.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "website-check-lab-tracker",
  "main": "src/lab/pages.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-check-lab-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "LAB_PAGE": "tracker-2s", "LAB_SLOT": "tracker" }
}
